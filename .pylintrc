[MAIN]
ignore=.venv,data,tests
jobs=0
py-version=3.11
load-plugins=

[MESSAGES CONTROL]
# Pydantic models and small services legitimately have few public methods.
disable=too-few-public-methods

[BASIC]
# Names shorter than 3 characters are refused (write `client`, not `db`; `frame`, not `df`).
good-names=_,i,j,k
variable-rgx=[a-z_][a-z0-9_]{2,40}$
argument-rgx=[a-z_][a-z0-9_]{2,40}$
attr-rgx=[a-z_][a-z0-9_]{2,40}$

[FORMAT]
max-line-length=120

[DESIGN]
max-args=8
max-positional-arguments=8
max-locals=20

[SIMILARITIES]
min-similarity-lines=8
ignore-imports=yes
