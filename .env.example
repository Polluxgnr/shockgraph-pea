# Copy to .env (make env) and change the passwords. .env is never committed.
# Shared, append-only: add lines, never edit or remove one.

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme-neo4j
NEO4J_DATABASE=neo4j

# Required in the X-API-Key header for POST /api/ask and POST /api/network/refresh
API_KEY=changeme-api-key

# LLM: "ollama" (local, free, runs in Docker) or "fake" (tests and CI)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_LARGE=qwen2.5:7b
OLLAMA_MODEL_SMALL=qwen2.5:3b

# Free API keys (optional but recommended): https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=
# https://www.openfigi.com/api (works without a key, with lower rate limits)
OPENFIGI_API_KEY=

# Port of the Nginx entry point on your machine
HTTP_PORT=80
